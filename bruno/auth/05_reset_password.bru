meta {
  name: Reset password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/reset-password
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "token": "{{resetToken}}",
    "email": "{{email}}",
    "password": "new-secret-password",
    "password_confirmation": "new-secret-password"
  }
}
